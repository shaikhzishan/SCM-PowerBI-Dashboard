// ============================================================
// SCM Power BI Dashboard — DAX Measures
// ============================================================

// --------------------
// Core Measures
// --------------------

Revenue =
SUM ( FactSales[Sales] )

Total Cost =
SUM ( FactSales[Cost] )

Gross Profit =
SUM ( FactSales[Gross Profit] )

Units Sold =
SUM ( FactSales[Units] )

Orders =
DISTINCTCOUNT ( FactSales[Order ID] )

Customers =
DISTINCTCOUNT ( FactSales[Customer ID] )


// --------------------
// Ratio Measures
// --------------------

Gross Margin % =
DIVIDE (
    [Gross Profit],
    [Revenue],
    0
)

Average Order Value =
DIVIDE (
    [Revenue],
    [Orders],
    0
)


// --------------------
// Time Intelligence
// --------------------

Revenue LY =
CALCULATE (
    [Revenue],
    SAMEPERIODLASTYEAR ( DimDate[Date] )
)

YoY Revenue =
[Revenue] - [Revenue LY]

YoY Revenue % =
DIVIDE (
    [YoY Revenue],
    [Revenue LY],
    0
)

Gross Profit LY =
CALCULATE (
    [Gross Profit],
    SAMEPERIODLASTYEAR ( DimDate[Date] )
)

YoY Gross Profit % =
DIVIDE (
    [Gross Profit] - [Gross Profit LY],
    [Gross Profit LY],
    0
)


// --------------------
// Target Measures
// --------------------

Sales Target =
SUM ( FactTargets[Target] )

Target Achievement % =
DIVIDE (
    CALCULATE (
        [Revenue],
        DimDate[Year] = 2024
    ),
    [Sales Target],
    0
)

Target Variance =
CALCULATE (
    [Revenue],
    DimDate[Year] = 2024
) - [Sales Target]

Target Gap % =
[Target Achievement %] - 1
